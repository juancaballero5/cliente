# Copias del dump: no deben estar en entorno/db/ (Docker ejecuta todos los .sql)
*_BACKUP.sql
*backup*.sql

# Material solo del docente (no va al kit / repo del curso)
DOCENTE-*
*.pdf
*.pptx
